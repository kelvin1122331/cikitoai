{
  "manifest_version": 3,
  "name": "CikitoAI — Asisten AI Mengambang",
  "short_name": "CikitoAI",
  "version": "1.0.0",
  "description": "Tempelkan bubble AI yang bisa digeser ke website mana pun. Dukung OpenAI, Claude, Gemini, Groq, OpenRouter, Ollama, atau endpoint kustom.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Buka CikitoAI di halaman ini",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Buka / tutup CikitoAI"
    }
  }
}
